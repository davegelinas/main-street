{
  "$id": "https://example.com/main-street/site.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Main Street site configuration: business facts, feature flags, integrations.",
  "properties": {
    "business": {
      "additionalProperties": false,
      "description": "Facts about the business. Used to render the site; never invent these.",
      "properties": {
        "address": {
          "additionalProperties": false,
          "properties": {
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "street": {
              "type": "string"
            },
            "zip": {
              "type": "string"
            }
          },
          "required": [
            "street",
            "city",
            "state",
            "zip"
          ],
          "type": "object"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "founded": {
          "type": "string"
        },
        "hours": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "days": {
                "type": "string"
              },
              "time": {
                "type": "string"
              }
            },
            "required": [
              "days",
              "time"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "social": {
          "additionalProperties": false,
          "properties": {
            "facebook": {
              "type": "string"
            },
            "instagram": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "tagline": {
          "type": "string"
        },
        "type": {
          "description": "Schema.org business type, e.g. Restaurant, HomeAndConstructionBusiness, ProfessionalService. Set by the preset.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "tagline",
        "phone",
        "email",
        "address",
        "hours"
      ],
      "type": "object"
    },
    "features": {
      "additionalProperties": false,
      "description": "Feature flags. Disabled features are stripped from the HTML at build time.",
      "properties": {
        "analytics": {
          "type": "boolean"
        },
        "announcementBanner": {
          "type": "boolean"
        },
        "blog": {
          "type": "boolean"
        },
        "booking": {
          "type": "boolean"
        },
        "contactForm": {
          "type": "boolean"
        },
        "emailSignup": {
          "type": "boolean"
        },
        "faq": {
          "type": "boolean"
        },
        "gallery": {
          "type": "boolean"
        },
        "menu": {
          "type": "boolean"
        },
        "testimonials": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "integrations": {
      "additionalProperties": false,
      "properties": {
        "bookingUrl": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "site": {
      "additionalProperties": false,
      "properties": {
        "announcement": {
          "description": "One-sentence banner. Empty string hides it.",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "domain": {
          "description": "Your domain, like acmeplumbing.com. Leave empty until you connect one; the site runs on its free Cloudflare address until then.",
          "type": "string"
        },
        "theme": {
          "description": "The site's look: colors, heading font, and corners. terracotta (warm, food and craft), harbor (navy and blue, trades and offices), sage (green, florists and wellness), plum (salons and spas). Set by the preset; the colors themselves live in src/styles.css.",
          "enum": [
            "terracotta",
            "harbor",
            "sage",
            "plum"
          ],
          "type": "string"
        }
      },
      "required": [
        "domain",
        "description"
      ],
      "type": "object"
    }
  },
  "required": [
    "business",
    "features",
    "site"
  ],
  "type": "object"
}
