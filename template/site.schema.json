{
  "$id": "https://example.com/main-street/site.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Main Street site configuration: business facts, feature flags, integrations.",
  "properties": {
    "business": {
      "additionalProperties": false,
      "description": "Facts about the business. Used to render the site; never invent these.",
      "properties": {
        "address": {
          "additionalProperties": false,
          "properties": {
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "street": {
              "type": "string"
            },
            "zip": {
              "type": "string"
            }
          },
          "required": [
            "street",
            "city",
            "state",
            "zip"
          ],
          "type": "object"
        },
        "email": {
          "format": "email",
          "type": "string"
        },
        "founded": {
          "type": "string"
        },
        "hours": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "days": {
                "type": "string"
              },
              "time": {
                "type": "string"
              }
            },
            "required": [
              "days",
              "time"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "social": {
          "additionalProperties": false,
          "properties": {
            "facebook": {
              "description": "Facebook page link or name. Empty = no Facebook link on the site.",
              "type": "string"
            },
            "instagram": {
              "description": "Instagram handle (@yourshop) or link. Empty = no Instagram link on the site.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "tagline": {
          "type": "string"
        },
        "type": {
          "description": "Schema.org business type, e.g. Restaurant, HomeAndConstructionBusiness, ProfessionalService. Set by the preset.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "tagline",
        "phone",
        "email",
        "address",
        "hours"
      ],
      "type": "object"
    },
    "features": {
      "additionalProperties": false,
      "description": "Feature flags. Disabled features are stripped from the HTML at build time.",
      "properties": {
        "analytics": {
          "type": "boolean"
        },
        "announcementBanner": {
          "type": "boolean"
        },
        "blog": {
          "type": "boolean"
        },
        "booking": {
          "type": "boolean"
        },
        "contactForm": {
          "type": "boolean"
        },
        "emailSignup": {
          "type": "boolean"
        },
        "faq": {
          "type": "boolean"
        },
        "gallery": {
          "type": "boolean"
        },
        "heroPhoto": {
          "description": "The big photo at the top of the homepage. Off until there is a real photo: the hero then shows the business's initial as a seal.",
          "type": "boolean"
        },
        "menu": {
          "type": "boolean"
        },
        "testimonials": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "integrations": {
      "additionalProperties": false,
      "properties": {
        "bookingUrl": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "site": {
      "additionalProperties": false,
      "properties": {
        "announcement": {
          "description": "One-sentence banner. Empty string hides it.",
          "type": "string"
        },
        "closedOn": {
          "description": "One-off closures: a date like \"2026-11-04\", a range like \"2026-12-24 to 2026-12-26\", or either with a short note: { \"dates\": \"2026-12-24 to 2026-12-26\", \"note\": \"for the holidays\" }. Each shows as its own line at the top of the homepage (\"Closed Thu, Dec 24 to Sat, Dec 26, for the holidays.\") from 21 days before until it ends, the page says \"Closed today\" on those days, and Google gets them as special hours. No announcement needed. Past closures drop off the site by themselves; the monthly checkup tidies them out of this list.",
          "items": {
            "oneOf": [
              {
                "pattern": "^\\d{4}-\\d{2}-\\d{2}( to \\d{4}-\\d{2}-\\d{2})?$",
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "dates": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}( to \\d{4}-\\d{2}-\\d{2})?$",
                    "type": "string"
                  },
                  "note": {
                    "description": "A few words that finish the sentence, like \"for the holidays\" or \"for the parade\".",
                    "maxLength": 60,
                    "type": "string"
                  }
                },
                "required": [
                  "dates"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "domain": {
          "description": "Your domain, like acmeplumbing.com. Leave empty until you connect one; the site runs on its free Cloudflare address until then.",
          "type": "string"
        },
        "theme": {
          "description": "The site's look: colors, heading font, and corners. terracotta (warm, food and craft), harbor (navy and blue, trades and offices), sage (green, florists and wellness), plum (salons and spas). Set by the preset; the colors themselves live in src/styles.css.",
          "enum": [
            "terracotta",
            "harbor",
            "sage",
            "plum"
          ],
          "type": "string"
        }
      },
      "required": [
        "domain",
        "description"
      ],
      "type": "object"
    }
  },
  "required": [
    "business",
    "features",
    "site"
  ],
  "type": "object"
}
